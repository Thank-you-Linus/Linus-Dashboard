  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sapiens-notifications.sh",
            "timeout": 5,
            "statusMessage": "SAPIENS notification"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sapiens-next-action.sh",
            "timeout": 5,
            "statusMessage": "SAPIENS next action"
          }
        ]
      }
    ]
  }
